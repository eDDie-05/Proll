# ---- Copy to .env and fill in. NEVER commit .env ----

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-64
JWT_SIGNING_KEY=change-me-a-different-long-random-string
DJANGO_ALLOWED_HOSTS=payroll.bravado.co.tz
DJANGO_CSRF_TRUSTED_ORIGINS=https://payroll.bravado.co.tz
CORS_ALLOWED_ORIGINS=https://payroll.bravado.co.tz
FRONTEND_URL=https://payroll.bravado.co.tz
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12
LOG_LEVEL=INFO

# Database (used by docker-compose to build DATABASE_URL)
POSTGRES_DB=bravado_payroll
POSTGRES_USER=bravado
POSTGRES_PASSWORD=change-me-strong-db-password
# For running the backend outside Docker:
# DATABASE_URL=postgres://bravado:password@localhost:5432/bravado_payroll

# Email (password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=payroll@bravado.co.tz

# Rate limits
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_PASSWORD_RESET=5/hour

# Nginx / TLS
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker/nginx/certs

# Backups
BACKUP_ENCRYPTION_PASSPHRASE=change-me-store-this-passphrase-offline-too
BACKUP_SCHEDULE=30 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE_RETENTION_DAYS=90
BACKUP_DIR=./backups
RCLONE_CONFIG_DIR=./docker/backup/rclone
# e.g. s3offsite:bravado-payroll-backups  (REQUIRED in production: backups must leave this server)
RCLONE_REMOTE=
